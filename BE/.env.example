PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=mysql://root:@localhost:3306/google_leads
GOOGLE_PLACES_API_KEY=your_google_key
HUNTER_API_KEY=your_hunter_api_key
HUNTER_API_BASE_URL=https://api.hunter.io/v2
# Required for sending through a connected Hunter mailbox
HUNTER_EMAIL_ACCOUNT_ID=your_hunter_email_account_id
AI_PROVIDER=template
# Optional when AI_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OUTREACH_SENDER_NAME=Your Name
OUTREACH_SENDER_EMAIL=you@yourdomain.com
OUTREACH_REPLY_TO=you@yourdomain.com
# Keep false until Hunter mailbox, suppression rules, and campaign policy are verified.
OUTREACH_ENABLED=false
# Telegram bot token from @BotFather. Configure only after deploying the API over HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 1–256 chars, A–Z/a–z/0–9/_/-. Generate a long random value and keep it secret.
TELEGRAM_WEBHOOK_SECRET=
# Full public URL, e.g. https://api.example.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
